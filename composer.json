{
    "name": "alt-design/alt-commerce-statamic",
    "description": "Sell products from a Statamic site: baskets, coupons, tax, stock, orders and Stripe payments.",
    "type": "statamic-addon",
    "license": "MIT",
    "keywords": [
        "statamic",
        "statamic-addon",
        "ecommerce",
        "cart",
        "orders",
        "stock",
        "stripe",
        "alt-design"
    ],
    "authors": [
        {
            "name": "Alt Design",
            "homepage": "https://alt-design.net"
        }
    ],
    "support": {
        "email": "support@alt-design.net",
        "issues": "https://github.com/alt-design/alt-commerce-statamic/issues"
    },
    "require": {
        "league/iso3166": "^4.3",
        "ext-intl": "*",
        "statamic/cms": "^6.35",
        "alt-design/alt-commerce": "^0.2"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "AltDesign\\AltCommerceStatamic\\": "src"
        }
    },
    "extra": {
        "statamic": {
            "name": "Alt Commerce",
            "description": "Sell products from a Statamic site: baskets, coupons, tax, stock, orders and Stripe payments.",
            "slug": "alt-commerce"
        },
        "laravel": {
            "providers": [
                "AltDesign\\AltCommerceStatamic\\ServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AltDesign\\AltCommerceStatamic\\Tests\\": "tests"
        }
    }
}
